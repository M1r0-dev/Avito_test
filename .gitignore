# Raw competition data stays local: put the three task parquet files here.
dataset/*.parquet

# Generated artefacts are local-only, except what the final solution needs.
# Those are tracked with Git LFS (see .gitattributes and README).
artifacts/*
!artifacts/bm25/
!artifacts/validation/
!artifacts/rankings/
artifacts/rankings/*
!artifacts/rankings/bm25_rankings.parquet
!artifacts/dense_kaggle/
artifacts/dense_kaggle/*
!artifacts/dense_kaggle/dense_rankings.parquet
!artifacts/dense_kaggle/dense_run.json
!artifacts/finetuned_dense_kaggle/
artifacts/finetuned_dense_kaggle/*
!artifacts/finetuned_dense_kaggle/finetuned_dense_rankings.parquet
!artifacts/finetuned_dense_kaggle/finetuned_dense_run.json
!artifacts/finetuned_v2_kaggle/
artifacts/finetuned_v2_kaggle/*
!artifacts/finetuned_v2_kaggle/finetuned_v2_dense_rankings.parquet
!artifacts/finetuned_v2_kaggle/finetuned_v2_dense_run.json
models/*
!models/learned_fusion_attempt3.cbm
!models/pu_selector_seed*.cbm

# Keep lightweight reports, but ignore regenerated binary figures.
reports/figures/*.png

# Python / notebooks / editors.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
.env
.idea/
.vscode/

# Intermediate submissions are local; the archive of files sent to the
# platform (submissions/attempt_*.csv) and the root answer.csv are tracked.
submissions/*
!submissions/attempt_*.csv
answer_*.csv
